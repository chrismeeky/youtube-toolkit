{
  "manifest_version": 3,
  "name": "YouTube Toolkit",
  "version": "1.3.4",
  "description": "Copy video details as clean text, plus outlier scores, views/hour, engagement and one-click transcripts \u2014 on any YouTube page.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://i.ytimg.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Toolkit settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "format.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-select-mode": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle multi-select mode on YouTube"
    },
    "copy-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy selected videos"
    }
  }
}
