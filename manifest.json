{
  "manifest_version": 3,
  "name": "YT Copy \u2014 Titles, Views & Dates",
  "version": "1.0.0",
  "description": "Copy YouTube video titles with view counts and/or upload time as clean, formatted text.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Copy settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "format.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-select-mode": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle multi-select mode on YouTube"
    },
    "copy-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy selected videos"
    }
  }
}
